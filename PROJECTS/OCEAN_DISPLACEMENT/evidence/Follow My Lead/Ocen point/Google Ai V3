dd_off = opt_off + (112 if magic == 0x20B else 96)
cli_rva = struct.unpack_from("<I", dll, dd_off + 14 * 8)[0]
num_sec = struct.unpack_from("<H", dll, pe_off + 6)[0]
opt_sz = struct.unpack_from("<H", dll, pe_off + 20)[0]
sec_off = opt_off + opt_sz
sections = [struct.unpack_from("<IIII", dll, sec_off + i * 40 + 8) for i in range(num_sec)]

def rva2off(rva):
    for vs, va, rs, ra in sections:
        if va <= rva < va + max(vs, 0x1000): return ra + (rva - va)
    return 0

cli_off = rva2off(cli_rva)
meta_off = rva2off(struct.unpack_from("<I", dll, cli_off + 8)[0])
ver_len = struct.unpack_from("<I", dll, meta_off + 12)[0]
st_off = meta_off + 16 + ver_len + 2
num_st = struct.unpack_from("<H", dll, st_off)[0]
curr = st_off + 2
streams = {}
for _ in range(num_st):
    so, ss = struct.unpack_from("<II", dll, curr)
    curr += 8
    nb = bytearray()
    while dll[curr] != 0: nb.append(dll[curr]); curr += 1
    curr = (curr + 4) & ~3
    streams[nb.decode("ascii")] = (meta_off + so, ss)

str_off, _ = streams["#Strings"]
tilde_off, _ = streams["#~"]
def rstr(idx): return dll[str_off + idx : dll.find(b"\x00", str_off + idx)].decode("utf-8", errors="ignore")

hs = dll[tilde_off + 6]
s_sz, g_sz, b_sz = (4 if hs&1 else 2), (4 if hs&2 else 2), (4 if hs&4 else 2)
vmask = struct.unpack_from("<Q", dll, tilde_off + 8)[0]
rc = {}; curr = tilde_off + 24
for t in range(64):
    if vmask & (1 << t): rc[t] = struct.unpack_from("<I", dll, curr)[0]; curr += 4

def isz(tbls): return 4 if max(rc.get(t,0) for t in tbls) >= (1 << (16 - (len(tbls)-1).bit_length())) else 2
tsz = {0:2+s_sz+g_sz*3, 1:isz([0,1,26,35])+s_sz*2, 2:4+s_sz*2+isz([1,2,27])+(4 if rc.get(4,0)>=65536 else 2)+(4 if rc.get(6,0)>=65536 else 2), 4:2+s_sz+b_sz}
toff = {}
for t in range(64):
    if t in rc:
        toff[t] = curr
        if t in tsz: curr += rc[t]*tsz[t]
        else: break
