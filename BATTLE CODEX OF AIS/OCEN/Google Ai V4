def tdor_name(coded):
    tag, row = coded & 3, coded >> 2
    if row == 0: return "None"
    if tag == 0 and 0x02 in toff:
        r = toff[0x02] + (row-1)*tsz[0x02]
        ns, nm = rstr(ridx(r+4+s_sz, s_sz)), rstr(ridx(r+4, s_sz))
        return f"{ns}.{nm}" if ns else nm
    if tag == 1 and 0x01 in toff:
        r = toff[0x01] + (row-1)*tsz[0x01]; rs = isz([0x00,0x01,0x1A,0x23])
        ns, nm = rstr(ridx(r+rs+s_sz, s_sz)), rstr(ridx(r+rs, s_sz))
        return f"{ns}.{nm}" if ns else nm
    return f"TypeSpec_{row}"

# Map CustomAttributes on Field rows (HasCustomAttribute tag for Field = 1)
field_attrs = {}
if 0x0C in toff:
    p_sz = isz([0x06,0x04,0x01,0x02,0x08,0x09,0x0A,0x00,0x0E,0x17,0x14,0x11,0x1A,0x1B,0x20,0x23,0x26,0x27,0x2A,0x2C,0x2B])
    t_sz = isz([0x06,0x0A])
    for ci in range(rc[0x0C]):
        cr = toff[0x0C] + ci * tsz[0x0C]
        parent = ridx(cr, p_sz)
        atype = ridx(cr + p_sz, t_sz)
        if (parent & 0x1F) == 1: # Tag 1 = Field table (0x04)
            frow = parent >> 5
            atag, arow = atype & 7, atype >> 3
            aname = "Attr"
            if atag == 3 and 0x0A in toff: # MemberRef
                mr = toff[0x0A] + (arow-1)*tsz[0x0A]; cs = isz([0x01,0x02,0x06,0x1A,0x1B])
                mp = ridx(mr, cs)
                if (mp & 7) == 1 and 0x01 in toff:
                    tr = toff[0x01] + ((mp>>3)-1)*tsz[0x01]; rs = isz([0x00,0x01,0x1A,0x23])
                    aname = f"{rstr(ridx(tr+rs+s_sz,s_sz))}.{rstr(ridx(tr+rs,s_sz))}"
            elif atag == 2 and 0x06 in toff: # MethodDef
                aname = rstr(ridx(toff[0x06]+(arow-1)*tsz[0x06]+8, s_sz))
            field_attrs.setdefault(frow, []).append(aname)

out = ["=== 1. INHERITANCE CHAIN & [SerializeField] CUSTOM ATTRIBUTE PROOF ==="]
td_map = {}
ext_sz = isz([0x01,0x02,0x1B])
f_idx_sz = 4 if rc.get(4,0)>=65536 else 2
for i in range(rc[0x02]):
    r = toff[0x02] + i * tsz[0x02]
    nm, ns = rstr(ridx(r+4, s_sz)), rstr(ridx(r+4+s_sz, s_sz))
    fn = f"{ns}.{nm}" if ns else nm
    base = tdor_name(ridx(r+4+s_sz*2, ext_sz))
    sf = ridx(r+4+s_sz*2+ext_sz, f_idx_sz)
    ef = ridx(toff[0x02]+(i+1)*tsz[0x02]+4+s_sz*2+ext_sz, f_idx_sz) if i+1 < rc[0x02] else rc[0x04]+1
    td_map[fn] = (base, sf, ef)

for target in ["Ceto.Ocean", "Ceto.OceanComponent", "Beam.CetoSettings"]:
    if target not in td_map: continue
    base, sf, ef = td_map[target]
    out.append(f"\nCLASS: {target} (Inherits from -> {base})")
    for fi in range(sf, ef):
        fr = toff[0x04] + (fi-1)*tsz[0x04]
        flg = u16(fr)
        fnm = rstr(ridx(fr+2, s_sz))
        attrs = field_attrs.get(fi, [])
        is_pub = (flg & 7) == 6
        is_stat = bool(flg & 0x10)
        is_ser = (not is_stat) and (is_pub or ("UnityEngine.SerializeField" in attrs))
        out.append(f"  Row #{fi:04d} | {fnm:<35} | public={str(is_pub):<5} | Attrs={str(attrs):<32} | UNITY_SERIALIZED={is_ser}")
